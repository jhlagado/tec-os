{
  "name": "tec-os",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "ROM-resident CP/M 2.2 compatible operating system for the TEC-1G",
  "license": "GPL-3.0-or-later",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "tecvol": "tools/tecvol.mjs"
  },
  "scripts": {
    "start": "esbuild --servedir=web/dist --serve=127.0.0.1:8765",
    "build": "node tools/build.mjs",
    "diag": "node tools/diag.mjs",
    "test": "node --test --test-concurrency=1 test/*.test.mjs",
    "test:strict": "STRICT=1 npm test",
    "media": "node tools/media.mjs",
    "check": "npm run build && npm test && npm run media && npm run web",
    "web": "node web/build.mjs",
    "inputs": "node tools/inputs.mjs",
    "caverns:scenarios": "node tools/caverns-scenario.mjs pack",
    "test:caverns-scenarios": "node --test test/caverns-scenario.test.mjs"
  },
  "devDependencies": {
    "@jhlagado/debug80-runtime": "0.3.3",
    "esbuild": "0.24.2",
    "playwright": "1.62.1"
  }
}
