diff -ruN a/src/cpm/ccpcmd.asm b/src/cpm/ccpcmd.asm
--- a/src/cpm/ccpcmd.asm	2026-11-16 11:49:00.843440652 +0000
+++ b/src/cpm/ccpcmd.asm	2026-11-16 11:49:00.845547531 +0000
@@ -195,13 +195,20 @@
 ; nothing changed. No driver is loaded.
 
 CONLCD:
-  ld hl,(GLVEC)
-  ld a,h
-  or l
-  jr nz,CONLT    ; a loaded driver's
-  ld hl,LCVTAB   ; none: the ROM's
+  ld a,(GLVEC+1)
+  or a
+  jr nz,CONLT    ; a driver is in
+  push bc
+  ld hl,LCDFCB   ; none: A:LCD.SVC
