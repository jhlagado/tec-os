@@ -98,18 +98,7 @@
   ld h,(hl)
   ld l,a         ; HL = the table
   or h
-  jr nz,CONSWV
-
-; No table. CRT falls back to TTY. UC1
-; is then the LCD's own console, which
-; needs the matrix keyboard.
-
-  bit 1,b        ; UC1 is 3, CRT 1
-  jr z,CONSWT
-  ld a,(CONDEV)
-  rrca           ; CDMTX
-  jr nc,CONSWT
-  ld hl,LCVTAB
+  jr z,CONSWT    ; none: TTY
 
 ; Copy seven vector words VPUTV..VFNV
