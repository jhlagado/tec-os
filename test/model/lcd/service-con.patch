+  ldir
+  call SVCGO
+  pop bc
+  jr c,CONLB     ; no file, no panel
 
 CONLT:
+  ld hl,(GLVEC)
   ld de,14       ; columns, then rows
   add hl,de
   ld a,c
diff -ruN a/src/lcd.asm b/src/lcd.asm
--- a/src/lcd.asm	2026-11-16 11:49:00.843549330 +0000
+++ b/src/lcd.asm	2026-11-16 11:49:00.845334563 +0000
@@ -16,14 +16,6 @@
   cp 4
   ret
 
-; Console restore: the three mode
-; commands again, without the clear, so
-; the screen stays over a warm boot.
-
-LCVRST:
-  ld b,3
-  jr LCDI0
-
 ; Attempt LCDSEQ's four commands:
 ; 8-bit, two-line, display on, cursor
 ; off, incrementing writes, clear.
@@ -66,33 +58,6 @@
   pop bc
   ret
 
-; Console put: A at row B, column C.
-; The panel has no reverse video, so
-; bit 7 is dropped. 80h alone is the
-; terminal's cursor flip, since the
-; console's get returns 0: nothing is
-; written, the hardware cursor goes on
-; while the terminal shows its cursor
-; (VCURV) and off otherwise, and the
-; address returns to the cell, where
-; that cursor stands.
-; Changes AF, E and HL.
-
-LCVPUT:
-  cp $80
-  jr z,LCVP1     ; a cursor flip
-  and $7F
-  ld e,a
-  call LCSEL
-  ld a,e
-  jr LCDD
-
-LCVP1:
-  ld a,(VCURV)
-  add a,a        ; 0Ch, or 0Eh shown
-  or $0C
-  call LCDC
-
 ; Address row B, column C: B=0..3,
 ; C below 20. LCDROWS lies in one page.
 ; Keeps BC and DE. Changes AF and HL.
@@ -126,62 +91,6 @@
   out (LCDDAT),a
   ret
 
-; Console clear: row B from column C to
-; its end. C at or past the width, a
-; pending wrap, clears nothing.
-; Changes AF, E and HL.
-
-LCVCLR:
-  ld a,(VWID)
-  sub c
-  ret c
-  ret z
-  ld e,a         ; cells to blank
-  call LCSEL
-
-LCVC1:
-  ld a,' '
-  call LCDD
-  dec e
-  jr nz,LCVC1
-  ret
-
-; Console row read: row B into LINEBUF,
-; from the panel's own display memory,
-; which is the only copy of the screen.
-; Changes AF, BC and HL.
-
-LCVRD:
-  call LCVROW
-
-LCVR1:
-  call LCDWAIT
-  ini            ; a cell in, B counts
-  jr nz,LCVR1
-  ret
-
-; Console row write: LINEBUF to row B.
-; Changes AF, BC and HL.
-
-LCVWR:
-  call LCVROW
-
-LCVW1:
-  call LCDWAIT
-  outi           ; a cell out
-  jr nz,LCVW1
-  ret
-
-; Address row B's first cell. Returns
-; HL=LINEBUF, B=20 cells, C=data port.
-
-LCVROW:
-  ld c,0
-  call LCSEL
-  ld hl,LINEBUF
-  ld bc,20*256+LCDDAT
-  ret
-
 ; Mark row 3 ROM-owned (CDWRD), then
 ; attempt HL's zero-terminated text.
 ; Returns B=3; otherwise as LCDROW.
diff -ruN a/src/tables.asm b/src/tables.asm
--- a/src/tables.asm	2026-11-16 11:49:00.843644822 +0000
+++ b/src/tables.asm	2026-11-16 11:49:00.845352221 +0000
@@ -50,18 +50,6 @@
 LCDROWS:
   DB $80,$C0,$94,$D4
 
-; The LCD console's table, as CONSWV
-; copies one: six terminal words, no
-; page function, columns and rows.
-; Its get is HWSPX, which returns 0:
-; the terminal reads a cell only to
-; flip the cursor, and LCVPUT takes the
-; 80h that follows as that flip.
-
-LCVTAB: DW LCVPUT,HWSPX,LCVCLR,LCVRST,LCVRD,LCVWR
-  DW 0
-  DB 20,4
-
 ; Built-in command records: keyword
 ; bytes, NUL, then LE handler word. A
 ; zero at the next keyword ends the
@@ -148,6 +136,7 @@
 ; three-byte type.
 
 GLCFCB: DB 1,"GLCD    SVC"
+LCDFCB: DB 1,"LCD     SVC"
 STFCB: DB 1,"STARTUP CMD"
 
 ; Initial stack room for services, in
